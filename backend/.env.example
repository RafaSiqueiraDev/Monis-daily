# Copia para backend/.env e preenche. Nunca commitar o .env real.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST/DBNAME
SECRET_KEY=gera-uma-chave-longa-e-aleatoria
ENVIRONMENT=development
REGISTRATION_INVITE_CODE=codigo-de-convite

# Cotações (opcionais). Sem elas, o Yahoo cobre tudo; o brapi sem token só
# cobre alguns tickers da B3 e a Twelve Data só entra com chave.
# BRAPI_TOKEN=
# TWELVE_DATA_API_KEY=
# QUOTES_CACHE_TTL_SECONDS=900

# Cron (cron-job.org -> POST /internal/quotes/sync-all com header
# X-Internal-Token). Sem valor, o endpoint fica desligado (503).
# Gerar com: python -c "import secrets; print(secrets.token_urlsafe(32))"
# INTERNAL_CRON_SECRET=
